PORT=3000
DATABASE_PATH=./data/carecloud.db
# Insert 2 demo patients on first start (set to false to disable)
SEED_DATA=true
# Clinic phone number shown on the dashboard (your Vapi number)
PUBLIC_PHONE_NUMBER=

# Public HTTPS URL of this server (from `npm run tunnel`), no trailing slash. Used by npm run setup:vapi.
PUBLIC_BASE_URL=

# Shared secret between Vapi and this server; setup:vapi puts it in the URLs it gives Vapi.
# Generate any long random string, e.g. node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
VAPI_SECRET=change-me-to-a-long-random-string
# Vapi PRIVATE API key (dashboard -> API Keys). Only needed by npm run setup:vapi, never by the server.
VAPI_API_KEY=
# Optional: preferred area code for the free number, and voice override (default: OpenAI 'onyx', male, speaks English + Urdu)
# VAPI_AREA_CODE=415
# VAPI_VOICE_PROVIDER=openai
# VAPI_VOICE_ID=onyx

# LLM: any OpenAI-compatible endpoint. Default = Groq free tier (https://console.groq.com/keys)
LLM_API_KEY=
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=openai/gpt-oss-120b
# Comma-separated models to try when the primary is rate-limited (free tiers have per-model quotas)
LLM_FALLBACK_MODELS=openai/gpt-oss-20b
# Free alternatives:
#   Google Gemini:  LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai  LLM_MODEL=gemini-2.5-flash
#   OpenRouter:     LLM_BASE_URL=https://openrouter.ai/api/v1  LLM_MODEL=meta-llama/llama-3.3-70b-instruct:free
#   Ollama (local): LLM_BASE_URL=http://localhost:11434/v1  LLM_MODEL=llama3.1
LLM_TIMEOUT_MS=7000
# Groq gpt-oss models: keep reasoning short for phone latency. Remove for providers that don't support it.
LLM_REASONING_EFFORT=low
